# ============================================
# MENTALYTICS - Environment Variables
# ============================================

# --------------------------------------------
# AI API KEYS - For 50 RPM (1 kelas capacity)
# --------------------------------------------

# GEMINI (Primary) - Google AI
# Free tier: 15 RPM per key
# Need 4 keys untuk 60 RPM (1 kelas ±40 murid)
# Get from: https://aistudio.google.com/app/apikey

VITE_GEMINI_API_KEY=AIza...your_first_gemini_key
VITE_GEMINI_API_KEY_2=AIza...your_second_gemini_key
VITE_GEMINI_API_KEY_3=AIza...your_third_gemini_key
VITE_GEMINI_API_KEY_4=AIza...your_fourth_gemini_key

# GROQ (Fallback) - LLaMA API
# Free tier: 30 RPM per key, 14,400 requests/day
# Need 2 keys untuk 60 RPM (backup capacity)
# Get from: https://console.groq.com/

VITE_GROQ_API_KEY=gsk_...your_first_groq_key
VITE_GROQ_API_KEY_2=gsk_...your_second_groq_key

# --------------------------------------------
# CAPACITY CALCULATOR
# --------------------------------------------
# Gemini: 4 keys × 15 RPM = 60 RPM
# Groq:   2 keys × 30 RPM = 60 RPM (fallback)
# TOTAL: 120 RPM (can handle 80+ concurrent users)
# --------------------------------------------

# --------------------------------------------
# SUPABASE DATABASE
# --------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJh...your_anon_key

# --------------------------------------------
# DEPLOYMENT NOTES
# --------------------------------------------
# For Vercel:
# 1. Add all keys to: Settings → Environment Variables
# 2. Apply to: Production, Preview, Development
# 3. Redeploy after adding keys
# 
# For testing capacity:
# - Monitor console: "TOTAL CAPACITY: X RPM"
# - Test with multiple users simultaneously
# --------------------------------------------


# ============================================
# AI SPEED MODE (Optional)
# ============================================
# Set to 'true' to use Groq as PRIMARY (skip Gemini retry)
# Makes AI respond INSTANTLY (no 5-6 sec delay from Gemini 503)
# Recommended when Gemini has 503 errors
VITE_FORCE_USE_GROQ=true
